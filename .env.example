# Telegram Bot
BOT_TOKEN=1234567890:AAH_YOUR_BOT_TOKEN_HERE
ADMIN_IDS=123456789,987654321
CHANNEL_USERNAME=@your_channel
SUPPORT_USERNAME=@your_support
BOT_USERNAME=@your_bot

# Database - PostgreSQL production
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/telegram_earning
# For local dev use SQLite: sqlite+aiosqlite:///./bot.db

# Redis (optional)
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change_me_random_secret

# Business Settings (defaults, overridable via Admin panel / DB)
DAILY_REWARD=5
DAILY_TASK_POINTS=10
POINTS_TO_CASH=0.01
MIN_WITHDRAWAL_BALANCE=100
MIN_WITHDRAWAL_AMOUNT=1.0
MIN_WITHDRAWAL_REFERRALS=3
REFERRAL_REWARD=5
CAMPAIGN_PROFIT_PERCENT=30
WITHDRAWAL_FEE_PERCENT=0
MAINTENANCE_MODE=false

# Logging
LOG_LEVEL=INFO
